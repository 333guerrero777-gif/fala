{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "^/js/(.*\\.json)$",
      "status": 403
    },
    {
      "src": "^/data_limits/(.*)$",
      "status": 403
    },
    {
      "src": "^/config/config\\.php$",
      "status": 403
    },
    {
      "src": "^/config/security\\.php$",
      "status": 403
    },
    {
      "src": "^/config/storage\\.php$",
      "status": 403
    },
    {
      "src": "^/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "^/img/(.*)",
      "dest": "/img/$1"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
